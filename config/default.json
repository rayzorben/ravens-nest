  "doctor_checks": [
    {
      "id": "core_runtime",
      "code": "Core",
      "title": "Raven Native Runtime & Bootstrap",
      "description": "Linux x86_64 kernel/Win32 syscall runtime (raven + raven-bootstrap)",
      "files": [
        "{native_dir}/raven",
        "{native_dir}/raven-bootstrap",
        "{native_dir}/l_intl.nls",
        "{native_dir}/x86/l_intl.nls"
      ],
      "repair_action": "build_runtime"
    },
    {
      "id": "controls_64",
      "code": "D5",
      "title": "64-bit Controls, UCRT & DirectWrite/Direct2D",
      "description": "Serves msvcrt.dll, ucrtbase.dll (~120 VC2022 exports), comctl32, raven-user32, raven-shell, DirectWrite & Direct2D",
      "files": [
        "{native_dir}/ucrtbase.dll",
        "{native_dir}/comctl32.dll",
        "{native_dir}/raven-user32.dll",
        "{native_dir}/raven-shell.dll",
        "{native_dir}/raven-dwrite.dll",
        "{native_dir}/raven-d2d1.dll",
        "{native_dir}/raven-uianimation.dll",
        "{native_dir}/raven-storage.dll",
        "{native_dir}/control.exe",
        "{native_dir}/regedit.exe",
        "{native_dir}/mscoree.dll"
      ],
      "repair_action": "provision_controls_64"
    },
    {
      "id": "controls_32",
      "code": "D9",
      "title": "32-bit (SysWOW64) Controls & UCRT",
      "description": "Required by 32-bit programs and 32-bit MSI custom actions in 64-bit installers",
      "files": [
        "{native_dir}/ucrtbase32.dll",
        "{native_dir}/x86/comctl32.dll",
        "{native_dir}/x86/raven-user32.dll",
        "{native_dir}/x86/raven-shell.dll",
        "{native_dir}/x86/raven-storage.dll",
        "{native_dir}/x86/control.exe",
        "{native_dir}/x86/regedit.exe",
        "{native_dir}/x86/mscoree.dll"
      ],
      "repair_action": "provision_controls_32"
    },
    {
      "id": "installer_64",
      "code": "D1 / D2",
      "title": "64-bit Windows Installer (MSI) & Multimedia/OLE Suite",
      "description": "msiexec.exe, msi.dll, cabinet.dll, sxs.dll, oleaut32, msxml3, windowscodecs, avifil32, avicap32, msacm32, dbgeng",
      "files": [
        "{native_dir}/msiexec.exe",
        "{native_dir}/regsvr32.exe",
        "{native_dir}/msi.dll",
        "{native_dir}/cabinet.dll",
        "{native_dir}/sxs.dll",
        "{native_dir}/oleaut32.dll",
        "{native_dir}/msxml3.dll",
        "{native_dir}/windowscodecs.dll",
        "{native_dir}/avifil32.dll",
        "{native_dir}/avicap32.dll",
        "{native_dir}/msacm32.dll",
        "{native_dir}/dbgeng.dll",
        "{native_dir}/raven-setupapi.dll"
      ],
      "repair_action": "provision_installer_64"
    },
    {
      "id": "installer_32",
      "code": "D9",
      "title": "32-bit (SysWOW64) Windows Installer (MSI) Suite",
      "description": "Prevents 64-bit MSI installers with 32-bit custom actions from hanging on SysWOW64\\msiexec.exe",
      "files": [
        "{native_dir}/x86/msiexec.exe",
        "{native_dir}/x86/regsvr32.exe",
        "{native_dir}/x86/msi.dll",
        "{native_dir}/x86/cabinet.dll",
        "{native_dir}/x86/sxs.dll",
        "{native_dir}/x86/oleaut32.dll",
        "{native_dir}/x86/msxml3.dll",
        "{native_dir}/x86/windowscodecs.dll",
        "{native_dir}/x86/avifil32.dll",
        "{native_dir}/x86/avicap32.dll",
        "{native_dir}/x86/msacm32.dll",
        "{native_dir}/x86/dbgeng.dll"
      ],
      "repair_action": "provision_installer_32"
    },
    {
      "id": "rtl_heap",
      "code": "D6",
      "title": "RTL Guest Heap Component (raven-rtl.dll)",
      "description": "Provides RtlAllocateHeap / GetProcessHeap for 64-bit processes",
      "files": [
        "{native_dir}/raven-rtl.dll"
      ],
      "repair_action": "provision_rtl"
    },
    {
      "id": "text_roots",
      "code": "D7",
      "title": "Text Layout Component & Root Certificates",
      "description": "raven-text.dll and Mozilla CA root certificates for Authenticode / TLS verification",
      "files": [
        "{native_dir}/raven-text.dll",
        "{roots_dir}"
      ],
      "check_glob": {
        "dir": "{native_dir}/roots",
        "pattern": "*.crt",
        "label": "build/native/roots/*.crt"
      },
      "repair_action": "provision_text_roots"
    },
    {
      "id": "skia_fonts",
      "code": "D8",
      "title": "Skia CPU Engine & Qualified Liberation Fonts",
      "description": "Required for GDI text metrics (GetTextMetricsW) and anti-aliased TrueType rendering",
      "files": [
        "{skia_library_path}",
        "{fonts_dir}/LiberationSans-Regular.ttf",
        "{fonts_dir}/LiberationMono-Regular.ttf",
        "{fonts_dir}/LiberationSerif-Regular.ttf"
      ],
      "repair_action": "reconfigure_cmake"
    },
    {
      "id": "graphics_d3d",
      "code": "D10",
      "title": "Direct3D 9/10/11/12 Translation Layer (DXVK + vkd3d-proton + d3dcompiler_47)",
      "description": "Hardware Vulkan acceleration for Direct3D 8/9/10/11 (DXVK) and Direct3D 12 (vkd3d-proton)",
      "files": [
        "{native_dir}/d3d9.dll",
        "{native_dir}/d3d10core.dll",
        "{native_dir}/d3d11.dll",
        "{native_dir}/dxgi.dll",
        "{native_dir}/d3d12.dll",
        "{native_dir}/d3d12core.dll",
        "{native_dir}/d3dcompiler_47.dll",
        "{native_dir}/x86/d3d9.dll",
        "{native_dir}/x86/d3d11.dll",
        "{native_dir}/x86/dxgi.dll",
        "{native_dir}/x86/d3dcompiler_47.dll"
      ],
      "repair_action": "provision_graphics"
    }
  ],
  "diagnostic_rules": [
    {
      "pattern": "missing DOS signature",
      "severity": "error",
      "title": "D1: MSI / Non-PE Package Executed Directly",
      "advice": "MSI packages are OLE compound documents. Use the 'Run Installer' button or wrap with msiexec.exe /i Z:\\path\\to\\file.msi."
    },
    {
      "pattern": "GetProcessHeap",
      "severity": "error",
      "title": "D6: Missing RTL Guest Heap Component (raven-rtl.dll)",
      "advice": "Run 'Auto-Deploy Libraries' or provision build/rtl-x64/raven-rtl.dll into build/native."
    },
    {
      "pattern": "GetTextMetricsW",
      "severity": "error",
      "title": "D8: Skia Text Engine Not Linked",
      "advice": "GDI text functions require RAVEN_SKIA=1 and matching Liberation font SHA-256 hashes. Use Deployment Doctor to reconfigure CMake."
    },
    {
      "pattern": "missing PE module: (msvcrt|ucrtbase)\\.dll",
      "severity": "error",
      "title": "D5: Missing Controls / UCRT Component Set",
      "advice": "Deploy ucrtbase.dll and comctl32.dll from build/controls-x64."
    },
    {
      "pattern": "unsupported native input event or input queue exhaustion",
      "severity": "warning",
      "title": "Issue 1 / F4: Wayland Input Queue or Keymap Error",
      "advice": "Ensure commit 5748053 (non-NUL keymap fix for niri) is built, or avoid high-rate pointer motion over blocked windows."
    },
    {
      "pattern": "missing PE export:\\s*([^\\n]+)",
      "severity": "error",
      "title": "Unresolved PE Import Symbol",
      "advice": "Inspect the executable in the Dependency Inspector to check if an app-local DLL or VC++ redistributable is missing."
    }
  ]
}
