{
  "server": {
    "host": "127.0.0.1",
    "port": 8470,
    "poll_interval_ms": 2500,
    "max_log_lines": 2000,
    "inspect_transitive_limit": 12
  },
  "paths": {
    "repo_root": "{auto_repo_root}",
    "build_dir": "{repo_root}/build",
    "native_dir": "{build_dir}/native",
    "raven_bin": "{native_dir}/raven",
    "prefixes_root": "{home}/.local/share/raven",
    "trash_root": "{prefixes_root}/.trash",
    "user_config_file": "{home}/.config/raven-nest/config.json",
    "local_bin_dir": "{home}/.local/bin",
    "desktop_entries_dir": "{home}/.local/share/applications",
    "fonts_dir": "/usr/share/fonts/liberation",
    "skia_source_dir": "{build_dir}/skia-src",
    "skia_library_path": "{build_dir}/skia-src/out/cpu/libskia.a",
    "roots_dir": "{build_dir}/roots",
    "rtl_component_path": "{build_dir}/rtl-x64/raven-rtl.dll",
    "text_component_path": "{build_dir}/text-x64/raven-text.dll",
    "controls64_dir": "{build_dir}/controls-x64",
    "controls32_dir": "{build_dir}/controls-x86",
    "installer64_dir": "{build_dir}/installer-x64",
    "installer32_dir": "{build_dir}/installer-x86",
    "graphics_dir": "{build_dir}/graphics",
    "testdata_dir": "{build_dir}/testdata"
  },
  "ui": {
    "title": "Raven Nest",
    "subtitle": "Windows Application Sandbox & Deployment Manager",
    "default_theme": "dark",
    "window_width": 1360,
    "window_height": 860,
    "default_timeout_ms": 86400000,
    "installer_timeout_ms": 1800000
  },
  "desktop_backends": [
    {
      "id": "wayland",
      "label": "Wayland Native (--desktop=wayland)",
      "flag": "--desktop=wayland"
    },
    {
      "id": "x11",
      "label": "X11 / XWayland (--desktop=x11)",
      "flag": "--desktop=x11"
    }
  ],
  "blueprints": [
    {
      "id": "gaming_cad",
      "name": "Gaming & CAD (Direct3D 11/12 + Qt6 + VC++ 2022)",
      "description": "Full DXVK + vkd3d-proton acceleration, Skia TrueType text, 32/64-bit MSI support, and VC++ 2015–2022 redistributables.",
      "default_desktop": "wayland",
      "default_env": {
        "RAVEN_BACKTRACE": "1"
      },
      "auto_deploy_redist": true
    },
    {
      "id": "app_sandbox",
      "name": "Application Sandbox (Standard Win32/Win64)",
      "description": "Isolated Windows C: drive and registry with Common Controls, RichEdit, OLE/COM servers, and UCRT.",
      "default_desktop": "wayland",
      "default_env": {
        "RAVEN_BACKTRACE": "1"
      },
      "auto_deploy_redist": true
    },
    {
      "id": "msi_mixed",
      "name": "Mixed 32/64-bit MSI Installer Environment",
      "description": "Pre-stages both System32 and SysWOW64 Windows Installer (msiexec.exe) and SxS assemblies for complex installers.",
      "default_desktop": "wayland",
      "default_env": {
        "RAVEN_BACKTRACE": "1"
      },
      "auto_deploy_redist": true
    },
    {
      "id": "minimal",
      "name": "Minimal Clean Sandbox",
      "description": "Clean prefix with core system utilities only; no pre-deployed third-party redistributables.",
      "default_desktop": "wayland",
      "default_env": {},
      "auto_deploy_redist": false
    }
  ],
  "snapshots": {
    "max_retained_auto": 10,
    "auto_snapshot_before_rollback": true,
    "auto_snapshot_before_delete": false,
    "default_manual_tag": "manual"
  },
  "font_qualification": {
    "required_files": [
      "LiberationSans-Regular.ttf",
      "LiberationMono-Regular.ttf",
      "LiberationSerif-Regular.ttf"
    ]
  },
  "toolchain": {
    "required_binaries": [
      "cmake",
      "ninja",
      "g++",
      "clang",
      "x86_64-w64-mingw32-gcc",
      "i686-w64-mingw32-gcc",
      "x86_64-w64-mingw32-dlltool",
      "x86_64-w64-mingw32-windres",
      "widl",
      "bison"
    ]
  },
  "prefix_system_programs": [
    "msiexec.exe",
    "regsvr32.exe",
    "control.exe",
    "dism.exe",
    "fondue.exe",
    "regedit.exe",
    "mscoree.dll",
    "riched20.dll",
    "msftedit.dll",
    "l_intl.nls"
  ],
  "discovery_excluded_executables": [
    "unins000.exe",
    "uninstall.exe",
    "crashpad_handler.exe",
    "qtwebengineprocess.exe",
    "vc_redist.x64.exe",
    "vc_redist.x86.exe",
    "dxsetup.exe"
  ],
  "sample_applications": [
    {
      "name": "Notepad++ 8.7.1 (Portable Test Suite)",
      "path": "{testdata_dir}/npp/notepad++.exe",
      "folder": "{testdata_dir}/npp",
      "install_folder_name": "Notepad++"
    },
    {
      "name": "SQLite3 CLI (64-bit Windows)",
      "path": "{testdata_dir}/sqlite3.exe"
    }
  ],
  "core_known_dlls": [
    "ntdll.dll", "kernel32.dll", "kernelbase.dll", "user32.dll", "gdi32.dll",
    "advapi32.dll", "ole32.dll", "combase.dll", "rpcrt4.dll", "shell32.dll",
    "shlwapi.dll", "setupapi.dll", "comdlg32.dll"
  ],
  "core_system_dlls": [
    "ntdll.dll", "kernel32.dll", "kernelbase.dll", "user32.dll", "gdi32.dll",
    "advapi32.dll", "ole32.dll", "combase.dll", "shell32.dll", "shlwapi.dll",
    "comdlg32.dll", "ws2_32.dll", "wsock32.dll", "crypt32.dll", "bcrypt.dll",
    "secur32.dll", "version.dll", "winmm.dll", "imm32.dll", "uxtheme.dll",
    "dwmapi.dll", "winspool.drv", "iphlpapi.dll", "dnsapi.dll", "netapi32.dll",
    "userenv.dll", "profapi.dll", "powrprof.dll", "wtsapi32.dll", "psapi.dll",
    "dbghelp.dll", "imagehlp.dll", "winhttp.dll", "wininet.dll", "mpr.dll",
    "msimg32.dll", "usp10.dll", "opengl32.dll", "glu32.dll", "vulkan-1.dll",
    "mfplat.dll", "mfreadwrite.dll", "xinput1_4.dll", "normaliz.dll",
    "hid.dll", "cfgmgr32.dll", "devobj.dll", "ntmarta.dll", "samlib.dll",
    "wevtapi.dll", "pdh.dll", "avrt.dll", "mmdevapi.dll", "dsound.dll",
    "dinput8.dll", "faultrep.dll", "wer.dll", "sensapi.dll", "oleacc.dll",
    "uiautomationcore.dll", "wintrust.dll", "ncrypt.dll", "cryptsp.dll",
    "rsaenh.dll", "cabinet.dll", "msi.dll", "sxs.dll", "rpcrt4.dll"
  ],
  "implicit_runtime_components": [
    {
      "dll": "raven-rtl.dll",
      "only_64": true,
      "target64": "{native_dir}/raven-rtl.dll",
      "source64": "{rtl_component_path}",
      "description": "Guest Heap Allocator (D6: RtlAllocateHeap / GetProcessHeap)"
    },
    {
      "dll": "raven-user32.dll",
      "only_64": false,
      "target64": "{native_dir}/raven-user32.dll",
      "target32": "{native_dir}/x86/raven-user32.dll",
      "source64": "{controls64_dir}/raven-user32.dll",
      "source32": "{controls32_dir}/raven-user32.dll",
      "description": "Built-in Control Classes & Dialog Manager (D5)"
    },
    {
      "dll": "raven-shell.dll",
      "only_64": false,
      "target64": "{native_dir}/raven-shell.dll",
      "target32": "{native_dir}/x86/raven-shell.dll",
      "source64": "{controls64_dir}/raven-shell.dll",
      "source32": "{controls32_dir}/raven-shell.dll",
      "description": "Graphical Shell & Common Dialogs Component (D5)"
    },
    {
      "dll": "raven-text.dll",
      "only_64": true,
      "target64": "{native_dir}/raven-text.dll",
      "source64": "{text_component_path}",
      "description": "Text Shaping & Layout Component (D7)"
    }
  ],
